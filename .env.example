# Configuration pour Book Style Extractor
# Copiez ce fichier en .env et remplissez vos clés

# Clé API Anthropic (Claude) - optionnelle pour analyse LLM enrichie
# Obtenez votre clé sur: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Modèle Claude à utiliser (optionnel, défaut: claude-sonnet-4-5-20250929)
# Options Claude 4.5 (décembre 2025):
#   - claude-sonnet-4-5-20250929  ($3/$15 per MTok) - Recommandé
#   - claude-haiku-4-5-20251001   ($1/$5 per MTok)  - Économique
#   - claude-opus-4-5-20251101    ($5/$25 per MTok) - Premium
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
