# Configuration pour Book Style Extractor
# Copiez ce fichier en .env et remplissez vos clés

# Clé API Anthropic (Claude) - optionnelle pour analyse LLM enrichie
# Obtenez votre clé sur: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Modèle Claude à utiliser (optionnel, défaut: claude-sonnet-4-20250514)
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514
CLAUDE_MODEL=claude-sonnet-4-20250514
